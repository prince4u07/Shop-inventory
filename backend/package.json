{
  "name": "shop-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "db:create": "node scripts/db-create.js",
    "prisma:generate": "prisma generate",
    "migrate:deploy": "prisma migrate deploy",
    "db:migrate": "npm run prisma:generate && npm run migrate:deploy",
    "seed": "node prisma/seed.js",
    "test": "node test/db-triggers.test.js && node test/api.test.js && node test/adversarial.js"
  },
  "dependencies": {
    "@prisma/client": "^6.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "prisma": "^6.6.0"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true
  }
}
